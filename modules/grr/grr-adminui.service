[Unit]
Description=GRR Rapid Response Admin UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/grr/venv/
ExecStart=/opt/grr/venv/bin/grr_server --component admin_ui --verbose
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target